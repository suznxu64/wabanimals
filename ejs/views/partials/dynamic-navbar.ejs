<%# I worked with ChatGPT for this code %>

<% const NAV_ITEMS = [
  { key: 'home',    label: 'Home',    url: '/' },
  { key: 'about',   label: 'About',   url: '/about' },
  { key: 'contact', label: 'Contact', url: '/contact' }
];
%>

<nav>
  <ul>
    <% NAV_ITEMS.forEach(item => { %>
      <li>
        <a href="<%= item.url %>"
           <% if (activePage === item.key) { %>
             aria-current="page"
           <% } %>>
          <%= item.label %>
        </a>
      </li>
    <% }) %>
  </ul>
</nav>
