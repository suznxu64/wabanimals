<!DOCTYPE html>
<html lang="en">
    <head>
    <meta charset="UTF-8">
    <title><%= user.userID %>'s Profile</title>
    <link rel="stylesheet" href="/styles.css">
    <link href="https://fonts.googleapis.com/css2?family=Pacifico&display=swap" rel="stylesheet">
    </head>
<body>
    <div class="profile-card">
        <h1><%= user.userID %>'s Profile</h1>

        <div class="stats">
            <div class="stat">
                <h3>Posts</h3>
                <p><%= user.numPosts %></p>
            </div>
            <div class="stat">
                <h3>Total Comments</h3>
                <p><%= user.numTotalComments %></p>
            </div>
            <div class="stat">
                <h3>Admin</h3>
                <p><%= user.admin ? "Yes" : "No" %></p>
            </div>
        </div>

        <div class="species">
            <h3>Species Sighted</h3>
            <% if (user.speciesSighted && user.speciesSighted.length > 0) { %>
                <% user.speciesSighted.forEach(function(species) { %>
                    <span><%= species %></span>
                <% }) %>
            <% } else { %>
                <p>No species sighted yet.</p>
            <% } %>
        </div>

       
    </div>
</body>
</html>