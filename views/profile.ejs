<!DOCTYPE html>
<html lang="en">
    <head>
    <meta charset="UTF-8">
    <title><%= user.userID %>'s Profile</title>
    <link rel="stylesheet" href="/styles.css">
    </head>
<body>
    <div class="profile-card">
        <h1><%= user.userID %>'s Profile</h1>

        <div class="stats">
            <div class="stat">
                <h3>Posts</h3>
                <p><%= user.numPosts %></p>
            </div>
            <div class="stat">
                <h3>Total Comments</h3>
                <p><%= user.numTotalComments %></p>
            </div>
            <div class="stat">
                <h3>Admin</h3>
                <p><%= user.admin ? "Yes" : "No" %></p>
            </div>
        </div>

        <div class="species">
            <h3>Species Sighted</h3>
            <% if (user.speciesSighted && user.speciesSighted.length > 0) { %>
                <% user.speciesSighted.forEach(function(species) { %>
                    <span><%= species %></span>
                <% }) %>
            <% } else { %>
                <p>No species sighted yet.</p>
            <% } %>
        </div>

        <% if (posts && posts.length > 0) { %>
            <div class="posts">
                <h3>Your Posts</h3>
                <% posts.forEach(function(post) { %>
                    <div class="post">
                        <strong><%= post.postTitle %></strong> - <em><%= post.species %></em><br>
                        <small>Sighted on <%= post.sightingDate %> at <%= post.sightingTime %></small><br>
                        <p><%= post.description %></p>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <p>You have not posted anything yet.</p>
        <% } %>
    </div>
</body>
</html>