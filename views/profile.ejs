<!DOCTYPE html>
<html lang="en">
    <head>
    <meta charset="UTF-8">
    <title><%= user.userID %>'s Profile</title>
    <link rel="stylesheet" href="/styles.css">
    <link href="https://fonts.googleapis.com/css2?family=Pacifico&display=swap" rel="stylesheet">
    </head>


<body>
            <%- include('partials/navbar.ejs') %>
                        <%- include('partials/flash.ejs') %>


    <div class="profile-container">


    <div class="profile-header">
        <div class="profile-avatar"><%= user.userID[0].toUpperCase() %></div>
        <div>
            <div class="profile-username"><%=user.userID%></div>
            <div class="profile-stats">
                <div class="stat-box">
                    <div class="stat-number"><%= user.numPosts %></div>
                    <div class="stat-label">Posts</div>
                </div>
                <div class="stat-box">
                    <div class="stat-number"><%= user.numTotalComments %></div>
                    <div class="stat-label">Comments</div>
                </div>
            </div>
        </div>
    </div>

    <div class="profile-section">
        <h2>Species Sighted</h2>
        <div class="species-tags">
            <% (user.speciesSighted ?? []).forEach(s => { %>
                <span class="species-tag"> <%= s %></span>
            <% }) %>
        </div>
    </div>

    <div class="profile-section profile-posts">
    <h2>My Sightings</h2>

    <% if (posts.length === 0) { %>
        <p style="color: #888;">You haven't posted any sightings yet!</p>
    <% } else { %>
        <% posts.forEach(post => { %>
            <%- include('partials/post_card.ejs', { post: post }) %>
             <% }) %>
                
        <% } %>

</div>
</div>
</body>
</html>