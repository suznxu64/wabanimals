<!--
Author: Nivale Baxendell
Description: seach bar for searching the database by species or xlocation
Date: 3/30
-->


<nav aria-label="Search">
    <form action="/search" method="GET">
        <fieldset>

            <label for="term">Search:</label>
            <input id="term" type="text" name="term" required value="<%= typeof term !== 'undefined' ? term : '' %>"
                placeholder="Enter search term">

            <label for="kind">Kind:</label>
            <select id="kind" name="kind" required>
                <option value="" disabled <%=!kind ? 'selected' : '' %>>
                    choose one
                </option>
                <option value="species" <%=kind==='species' ? 'selected' : '' %>>
                    species
                </option>
                <option value="location" <%=kind==='location' ? 'selected' : '' %>>
                    location
                </option>
            </select>

            <button type="submit">Search posts</button>
        </fieldset>
    </form>
</nav>