Author: Nivale, Ari, Suzy
Description: Structure of all post messages
Date: April 2026
-->
<div class="card">
    <div class="card-content">

        <!-- Text content of the post -->
        <div class="text">
            <h2 class="post-title">
                <%= post.postTitle %>
            </h2>

            <p class="post-text">
                <strong>Posted by:</strong>
                <%= post.userID %>
            </p>

            <p class="post-text">
                <strong>Posted on:</strong>
                <% if (post.createdAt) { %>
                    <%= new Date(post.createdAt).toLocaleDateString() %>
                        <% } else { %>
                            Unknown time
                            <% } %>
            </p>

            <!-- species -->
            <p class="post-text">
                <strong>Species:</strong>
                <%= post.species %>
            </p>

            <!-- location -->
            <p class="post-text">
                <strong>Location:</strong>
                <%= post.sightingLocation %>
            </p>

            <!-- date -->
            <p class="post-text">
                <strong>Date:</strong>
                <%= post.sightingDate %> at <%= post.sightingTime %>
            </p>


            <!-- description -->
            <p class="post-text">
                <%= post.description %>
            </p>
            <!-- if logged in user is the author of the post then they can update -->
            <% if (session.logged_in && session.userID===post.userID) { %>
                <a href="/update-post/<%= post.postID %>">
                    <button class="updateBtn">Update Post</button>
                </a>
                <% } %>

                <!-- if logged in user is author or admin they can delete -->

                    <% if (session.logged_in && session.userID===post.userID || isAdmin) { %>
                        <form method="POST" action="/delete-post">
                            <input type="hidden" name="postID" value="<%= post.postID %>">
                            <button class="deleteBtn" type="submit">Delete Post</button>
                        </form>
                        <% } %>
        </div>

        <!-- actual image -->
        <img class="post-image" src="/uploads/<%= post.imageName %>" alt="<%= post.title %>">

        <!--"Like" section-->
        <div class="post-actions">

            <button class="likeBtn" type="button" data-postid="<%= post.postID %>">
                👍 Like
            </button>
            
            <p class="post-text like-text">
                <strong>Likes:</strong>
                <span class="like-count">
                    <%= post.likes || 0 %>
                </span>
            </p>



        </div>

        <div class="comments-section">

            <!--Comment section-->
            <div class="comments-header">
                💬 Comments (<%= post.comments ? post.comments.length : 0 %>)
            </div>

            <div class="comment-list">
                <% if (post.comments && post.comments.length> 0) { %>
                    <% post.comments.forEach(c=> { %>
                        <div class="comment">
                            <span class="comment-user">
                                <%= c.userID %>
                            </span>
                            <span class="comment-text">
                                <%= c.text %>
                            </span>
                        </div>
                        <% }) %>
                            <% } else { %>
                                <div class="no-comments">No comments yet.</div>
                                <% } %>
            </div>

            <!-- can comment if logged in -->
            <% if (session.logged_in) { %>
                <form class="comment-form">
                    <input type="text" class="comment-input" placeholder="Write a comment..." required>
                    <button type="button" class="commentBtn" data-postid="<%= post.postID %>">
                        Post
                    </button>
                </form>
                <% } %>

        </div>


    </div>

</div>