<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <title>Wabanimals Search</title>
    <!-- load local stylesheet (css) -->
    <link rel="stylesheet" href="/styles.css" />
    <!-- loading jquery -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
</head>


<body>

    <!--include navbar -->

    <%- include('partials/navbar') %>
        <div class="content">
            <h1>Wabanimals Search</h1>

            <!--include  seach bar -->
            <%- include('partials/search_bar') %>

                <% if (results===null) { %>
                    <h3>Use the search bar above to filter animal sightings by species and by location on campus.</h3>
                    <% } else { %>

                        <h3>Results for "<%= term %>"</h3>

                        <% if (results.length===0) { %>
                            <p>No results found.</p>
                            <% } %>

                                <% results.forEach(post=> { %>
                                    <%- include('partials/post_card.ejs', { post: post }) %>
                                        <% }) %>
                                            <% } %>
        </div>
</body>

</html>