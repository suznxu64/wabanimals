<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <title>Wabanimals Search</title>
    <!-- load local stylesheet (css) -->
    <link rel="stylesheet" href="/styles.css" />
    <!-- loading jquery -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
</head>


<body>
    <!--include navbar -->
    <%- include('partials/navbar') %>
        <h1>Wabanimals Search</h1>

        <!--include  seach bar -->
        <%- include('partials/search_bar') %>

            <% if (results===null) { %>
                <p>Use the search bar above to find animal sightings.</p>
                <% } else { %>

                    <h2>Results for "<%= term %>"</h2>

                    <% if (results.length===0) { %>
                        <p>No results found.</p>
                        <% } %>

                            <% results.forEach(post=> { %>
                                <div class="card">
                                    <div class="card-content">
                                        <div class="text">
                                            <h2 class="post-title">
                                                <%= post.postTitle %>
                                            </h2>
                                            <p class="post-text"><strong>Species:</strong>
                                                <%= post.species %>
                                            </p>
                                            <p class="post-text"><strong>Location:</strong>
                                                <%= post.sightingLocation %>
                                            </p>
                                            <p class="post-text"><strong>Date:</strong>
                                                <%= post.sightingDate %>
                                            </p>
                                            <p class="post-text">
                                                <%= post.description %>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                                <% }) %>
                                    <% } %>
</body>

</html>