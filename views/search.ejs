<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <title>Wabanimals Search</title>
    <!-- load local stylesheet (css) -->
    <link rel="stylesheet" href="/styles.css" />
    <!-- loading jquery -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
</head>


<body>

    <!--include navbar -->

    <%- include('partials/navbar') %>
        <div class="content">
            <h1>Wabanimals Search</h1>

            <!--include  seach bar -->
            <%- include('partials/search_bar') %>

                <% if (results===null) { %>
                    <h3>Use the search bar above to filter animal sightings by species and by location on campus.</h3>
                    <% } else { %>

                        <h3>Results for "<%= term %>"</h3>

                        <% if (results.length===0) { %>
                            <p>No results found.</p>
                            <% } %>

                                <% results.forEach(post=> { %>
                                    <div class="card">
                                        <div class="card-content">
                                            <div class="text">
                                                <h2 class="post-title">
                                                    <%= post.postTitle %>
                                                </h2>
                                                <p class="post-text"><strong>Species:</strong>
                                                    <%= post.species %>
                                                </p>
                                                <p class="post-text"><strong>Location:</strong>
                                                    <%= post.sightingLocation %>
                                                </p>
                                                <p class="post-text">
                                                    <%= post.description %>
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                    <% }) %>
                                        <% } %>
        </div>
</body>

</html>