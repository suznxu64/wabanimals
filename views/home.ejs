<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="author" content="Ariana Inamdar, Suzy Xu, Nivale Baxendell">

    <!-- CSS -->
    <link rel="stylesheet" href="/styles.css">
    <link href="https://fonts.googleapis.com/css2?family=Pacifico&display=swap" rel="stylesheet">

    <title>Wabanimals</title>
</head>

<body>

    <!-- Navbar -->
    <%- include('partials/navbar.ejs') %>

    <%- include('partials/flash.ejs') %>

    

    <!-- Main content container -->
    <div class="content">

        <!-- Intro text -->
        <h1>Welcome to Wabanimals!</h1>
        <h3>
            Wabanimals is a animal sighting platform for Wellesley College.
            Post the animals you've seen around campus using the "Upload" tab, and explore sightings from 
            others on our community feed.
        </h3>

            <!-- Feed header -->
            <h1>The Community Feed</h1>
            <h3>Recent Wellesley College animal sightings:</h3>

            <!-- Example post card -->
            <div class="card">
                <div class="card-content">
                    <div class="text">
                        <h2 class="post-title">Three Cute Bunnies</h2>
                        <p class="post-text">Spotted on Severance Green this morning.</p>
                        <p class="post-text">They were hopping around together.</p>
                    </div>
                    <img class="post-img" src="/bunny.jpeg" alt="Bunny">
                </div>
            </div>

    </div> <!-- End content -->

</body>

</html>