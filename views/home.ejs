<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="author" content="Ariana Inamdar, Suzy Xu, Nivale Baxendell">

    <!-- CSS -->
    <link rel="stylesheet" href="/styles.css">
    <link href="https://fonts.googleapis.com/css2?family=Pacifico&display=swap" rel="stylesheet">

    <title>Wabanimals</title>
</head>

<body>

    <!-- Navbar -->
    <%- include('partials/navbar.ejs') %>

        <%- include('partials/flash.ejs') %>



            <!-- Main content container -->
            <div class="content">

                <!-- Intro text -->
                <h1>Welcome to Wabanimals!</h1>
                <h2>
                    Wabanimals is a platform dedicated to animal sightings at Wellesley College. <br><br>
                    Post the animals you've seen around campus using the "Upload" tab in the navigation bar, and explore
                    sightings from
                    others on our community feed. <br><br>
                    Only want to see specific types of posts? Use our "Search"
                    tab to filter by animal or location sighted.
                </h2>
                <section class = "stats">
                    <div class="stats-grid">
                        <div class="stat-card">
                            <span class="stat-number">
                                 <!-- data overview bar to show overall stats -->
                                   <!-- how many posts in the database -->
                                <%= totalPosts %>
                            </span>
                            <span class="stat-label">Posts</span>
                        </div>
                        <div class="stat-card">
                            <span class="stat-number">
                                 <!-- total species sighted -->
                                <%= totalSpecies %>
                            </span>
                            <span class="stat-label">Species</span>
                        </div>
                        <div class="stat-card">
                            <span class="stat-number">
                                 <!--total users-->
                                <%= totalUsers %>
                            </span>
                            <span class="stat-label">Users</span>
                        </div>
                    </div>
                </section>
                <!-- Feed header -->
                <h1>The Community Feed</h1>
                <h2>Recent Wellesley College animal sightings:</h2>


                <!-- COMMUNITY FEED: dynamically renders posts from MongoDB -->
                <!-- 'posts' is passed in from the '/' route in server.js -->


                <% if (posts && posts.length> 0) { %>

                    <% posts.forEach(post=> { %>
                         <!-- for each post, display it through the card ejs -->
                        <%- include('partials/post_card.ejs', { post: post }) %>
                            <% }) %>

                                <% } else { %>
                                    <!-- Message when no posts exist yet -->
                                    <p>No sightings yet. Be the first to upload one!</p>

                                    <% } %>

            </div>

            <!-- "Client-side" frontend Javascript for handling ajax "like" button-->
            <script>
                document.querySelectorAll('.likeBtn').forEach(button => {
                    button.addEventListener('click', async () => {
                        try {
                            const postID = button.dataset.postid;

                            const res = await fetch(`/likeAjax/${postID}`, {
                                method: 'POST'
                            });

                            const data = await res.json();

                            console.log("Response:", data);

                            if (!data.error) {
                                const likeCountSpan = button
                                    .closest('.card-content')
                                    .querySelector('.like-count');

                                if (likeCountSpan) {
                                    likeCountSpan.textContent = data.likes;
                                }
                            } else {
                                alert(data.message);
                            }

                        } catch (err) {
                            console.error(err);
                        }
                    });
                });

                //"Client-side" frontend Javascript for handling ajax commenting
            
                document.querySelectorAll('.commentBtn').forEach(button => {
                    button.addEventListener('click', async () => {
                        const postID = button.dataset.postid;
                        const container = button.closest('.comments-section');
                        const input = container.querySelector('.comment-input');
                        const text = input.value;

                        if (!text.trim()) return;

                        const res = await fetch(`/commentAjax/${postID}`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ text })
                        });

                        const data = await res.json();

                        if (!data.error) {
                            const list = container.querySelector('.comment-list');

                            list.innerHTML = data.comments.map(c => `
                <p><strong>${c.userID}:</strong> ${c.text}</p>
            `).join('');

                            input.value = "";
                        } else {
                            alert(data.message);
                        }
                    });
                });

            </script>

</body>

</html>